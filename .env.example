# Copy to .env. Never commit credentials. Use URL-safe random values for these two.
POSTGRES_PASSWORD=
ADMIN_TOKEN=
# Empty DATABASE_URL uses local JSON demo storage (one Node process only).
DATABASE_URL=
# Supabase hosted or CLI local Auth; same Postgres must contain organiser_profiles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only data API key; never use a NEXT_PUBLIC prefix.
SUPABASE_SECRET_KEY=
# Optional SQL installation via the Management API (not the project secret key).
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
LUMA_DISCOVER_URL=
LUMA_EVENT_URL=
LUMA_ICS_URL=
DEVPOST_URL=
BUILDERBASE_URL=
MEETUP_URL=
MLH_URL=
DEV_EVENTS_URL=
HACK_RADAR_URL=
HACK_COLLECTIVE_URL=
OSM_ENABLED=false
OVERTURE_GEOJSON_PATH=
OVERTURE_RELEASE=
TFL_ENABLED=false
TFL_APP_KEY=
COGNEE_URL=
COGNEE_TOKEN=
XAI_API_KEY=
XAI_MODEL=
DISCORD_WEBHOOK_URL=
